<?xml version="1.0" encoding="utf-8"?>
<!--
  The round variant, referenced by android:roundIcon.

  Identical to ic_launcher.xml on purpose: an adaptive icon is already mask-agnostic — the
  launcher applies whatever shape the device uses to these same layers. This file exists so
  that launchers which still ask for roundIcon by name get an adaptive icon back rather
  than falling through to the platform default.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/swipey_icon_ground" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
